# Server-side base URL the Next.js app uses to reach the backend BFF.
# In Docker compose this resolves via the internal network.
KUMBUKA_BACKEND_URL=http://kumbuka-backend:8080

# Public app name shown in titles.
NEXT_PUBLIC_APP_NAME=kumbuka.ai

# Set to "1" to bypass the backend and run on bundled mock data
# (useful while the backend is still wiring up endpoints).
KUMBUKA_API_MOCK=0

# Set to "1" to ALSO mock the session/auth layer while in mock mode. Only
# takes effect when KUMBUKA_API_MOCK=1; otherwise the real OIDC sign-in flow
# always runs so /signin is exercised end-to-end.
KUMBUKA_API_MOCK_SESSION=0

# Release version of a downstream composition build that wraps this app.
# Surfaced in the footer, with this package's own version shown as its core.
# Leave blank for a standalone install (no separate deployable).
KUMBUKA_BUILD_VERSION=
